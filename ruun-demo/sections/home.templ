package sections

templ HomePage() {
    @DemoLayout("Overview", "overview") {
        <div class="p-8">
            // Hero Section
            <div class="text-center py-12 mb-12">
                <h1 class="text-4xl font-bold text-gray-900 mb-4">Ruun UI Components</h1>
                <p class="text-lg text-gray-600 mb-6 max-w-2xl mx-auto">
                    A pure Go/Templ component library. No HTML, no CSS classes - just functions.
                </p>
                <div class="flex gap-3 justify-center flex-wrap">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-blue-100 text-blue-800">Go</span>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-green-100 text-green-800">Templ</span>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-purple-100 text-purple-800">HTMX</span>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-orange-100 text-orange-800">Alpine.js</span>
                </div>
            </div>
            
            // Stats Grid
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
                <div class="bg-white p-6 rounded-lg border border-gray-200 text-center">
                    <div class="text-4xl mb-2">⚛️</div>
                    <h3 class="text-lg font-semibold mb-1">Atoms</h3>
                    <p class="text-gray-600 text-sm">24 basic components</p>
                </div>
                <div class="bg-white p-6 rounded-lg border border-gray-200 text-center">
                    <div class="text-4xl mb-2">🧬</div>
                    <h3 class="text-lg font-semibold mb-1">Molecules</h3>
                    <p class="text-gray-600 text-sm">20 complex components</p>
                </div>
                <div class="bg-white p-6 rounded-lg border border-gray-200 text-center">
                    <div class="text-4xl mb-2">🦠</div>
                    <h3 class="text-lg font-semibold mb-1">Organisms</h3>
                    <p class="text-gray-600 text-sm">18 layout components</p>
                </div>
                <div class="bg-white p-6 rounded-lg border border-gray-200 text-center">
                    <div class="text-4xl mb-2">📐</div>
                    <h3 class="text-lg font-semibold mb-1">Templates</h3>
                    <p class="text-gray-600 text-sm">12 page layouts</p>
                </div>
            </div>
            
            // Quick Preview
            <div class="space-y-8">
                <h2 class="text-2xl font-semibold text-gray-900">Quick Preview</h2>
                
                // Buttons preview
                <div class="bg-white p-6 rounded-lg border border-gray-200">
                    <h3 class="text-lg font-semibold mb-4">Buttons</h3>
                    <div class="flex gap-4 flex-wrap">
                        <button class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700">Primary</button>
                        <button class="px-4 py-2 bg-gray-600 text-white rounded-md hover:bg-gray-700">Secondary</button>
                        <button class="px-4 py-2 border border-gray-300 rounded-md hover:bg-gray-50">Outline</button>
                        <button class="px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700">Destructive</button>
                        <button class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-md">Ghost</button>
                    </div>
                </div>
                
                // Cards preview
                <div class="bg-white p-6 rounded-lg border border-gray-200">
                    <h3 class="text-lg font-semibold mb-4">Cards</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="border border-gray-200 rounded-lg p-4">
                            <h4 class="font-semibold mb-2">Card Title</h4>
                            <p class="text-gray-600 text-sm mb-3">Card description here</p>
                            <p class="text-gray-800">Card content</p>
                        </div>
                        <div class="border border-gray-200 rounded-lg p-4">
                            <h4 class="font-semibold mb-2">Another Card</h4>
                            <p class="text-gray-800">More content</p>
                        </div>
                    </div>
                </div>
                
                // Usage Example
                <div class="bg-white p-6 rounded-lg border border-gray-200">
                    <h3 class="text-lg font-semibold mb-6">How to Use</h3>
                    <div class="space-y-6">
                        <div>
                            <h4 class="font-medium mb-2">Installation</h4>
                            <pre class="bg-gray-100 p-4 rounded text-sm overflow-x-auto"><code>go get github.com/niiniyare/ruun</code></pre>
                        </div>
                        
                        <div>
                            <h4 class="font-medium mb-2">Import</h4>
                            <pre class="bg-gray-100 p-4 rounded text-sm overflow-x-auto"><code>import (
    "github.com/niiniyare/ruun/views/components/atoms"
    "github.com/niiniyare/ruun/views/components/molecules"
    "github.com/niiniyare/ruun/views/components/organisms"
)</code></pre>
                        </div>
                        
                        <div>
                            <h4 class="font-medium mb-2">Usage</h4>
                            <pre class="bg-gray-100 p-4 rounded text-sm overflow-x-auto"><code>@atoms.Flex(atoms.FlexProps{Gap: atoms.Gap4}) {
    @atoms.Button(atoms.ButtonProps{Text: "Save"})
    @atoms.Button(atoms.ButtonProps{
        Text: "Cancel",
        Variant: atoms.ButtonOutline,
    })
}</code></pre>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}