package sections

import (
	"github.com/niiniyare/ruun/components/atoms"
	"github.com/niiniyare/ruun/components/molecules"
	"github.com/niiniyare/ruun/components/organisms"
	"github.com/niiniyare/ruun/components"
)

templ HomePage() {
	@DemoLayout("Overview", "overview") {
		// Hero Section
		@atoms.Flex(atoms.FlexProps{
			Direction: components.FlexCol,
			Align:     components.AlignCenter,
			Justify:   components.JustifyCenter,
			Base: components.BaseProps{
				ClassName: "text-center py-12",
			},
		}) {
			@atoms.Text(atoms.TextProps{
				Content: "Ruun UI Components",
				Variant: components.TextHeading,
				Size:    components.Text3XL,
				Weight:  components.WeightBold,
			})
			@atoms.Text(atoms.TextProps{
				Content: "A pure Go/Templ component library. No HTML, no CSS classes - just functions.",
				Size:    components.TextLg,
				Color:   components.ColorMuted,
				Base: components.BaseProps{
					ClassName: "mt-4 mb-6",
				},
			})
			@atoms.Flex(atoms.FlexProps{
				Gap: components.Gap2,
				Wrap: true,
			}) {
				@atoms.Badge(atoms.BadgeProps{
					Content: "Go",
					Variant: components.BadgePrimary,
				})
				@atoms.Badge(atoms.BadgeProps{
					Content: "Templ",
					Variant: components.BadgeSecondary,
				})
				@atoms.Badge(atoms.BadgeProps{
					Content: "HTMX",
					Variant: components.BadgeOutline,
				})
				@atoms.Badge(atoms.BadgeProps{
					Content: "Alpine.js",
					Variant: components.BadgeOutline,
				})
			}
		}
		
		// Stats Grid
		@atoms.Grid(atoms.GridProps{
			Columns: 4,
			Gap:     components.Gap6,
			Base: components.BaseProps{
				ClassName: "px-6 mb-8",
			},
		}) {
			@molecules.Card(molecules.CardProps{
				Base: components.BaseProps{
					ClassName: "text-center",
				},
				Content: statsCardContent("⚛️", "24", "Atoms"),
			})
			@molecules.Card(molecules.CardProps{
				Base: components.BaseProps{
					ClassName: "text-center",
				},
				Content: statsCardContent("🧬", "20", "Molecules"),
			})
			@molecules.Card(molecules.CardProps{
				Base: components.BaseProps{
					ClassName: "text-center",
				},
				Content: statsCardContent("🦠", "18", "Organisms"),
			})
			@molecules.Card(molecules.CardProps{
				Base: components.BaseProps{
					ClassName: "text-center",
				},
				Content: statsCardContent("📐", "12", "Templates"),
			})
		}
		
		// Quick Preview Section
		@atoms.Flex(atoms.FlexProps{
			Direction: components.FlexCol,
			Gap:       components.Gap8,
			Base: components.BaseProps{
				ClassName: "px-6",
			},
		}) {
			@atoms.Text(atoms.TextProps{
				Content: "Quick Preview",
				Variant: components.TextHeading,
				Size:    components.Text2XL,
				Weight:  components.WeightSemibold,
			})
			
			// Buttons Preview
			@Section("Buttons") {
				@atoms.Flex(atoms.FlexProps{
					Gap:  components.Gap4,
					Wrap: true,
				}) {
					@atoms.Button(atoms.ButtonProps{
						Text:    "Primary",
						Variant: components.ButtonPrimary,
					})
					@atoms.Button(atoms.ButtonProps{
						Text:    "Secondary",
						Variant: components.ButtonSecondary,
					})
					@atoms.Button(atoms.ButtonProps{
						Text:    "Outline",
						Variant: components.ButtonOutline,
					})
					@atoms.Button(atoms.ButtonProps{
						Text:    "Destructive",
						Variant: components.ButtonDestructive,
					})
					@atoms.Button(atoms.ButtonProps{
						Text:    "Ghost",
						Variant: components.ButtonGhost,
					})
				}
			}
			
			// Cards Preview
			@Section("Cards") {
				@atoms.Grid(atoms.GridProps{
					Columns: 2,
					Gap:     components.Gap6,
				}) {
					@molecules.Card(molecules.CardProps{
						Title:       "Card Title",
						Description: "Card description here",
						Content: cardContent("Card content"),
					})
					@molecules.Card(molecules.CardProps{
						Title:   "Another Card",
						Content: cardContent("More content"),
					})
				}
			}
		}
		
		// Usage Example Section
		@Section("How to Use") {
			@atoms.Grid(atoms.GridProps{
				Columns: 1,
				Gap:     components.Gap6,
			}) {
				@molecules.Card(molecules.CardProps{
					Title:   "Installation",
					Content: codeContent("bash", "go get github.com/niiniyare/ruun"),
				})
				
				@molecules.Card(molecules.CardProps{
					Title: "Import",
					Content: codeContent("go", `import (
    "github.com/niiniyare/ruun/components/atoms"
    "github.com/niiniyare/ruun/components/molecules"
    "github.com/niiniyare/ruun/components/organisms"
)`),
				})
				
				@molecules.Card(molecules.CardProps{
					Title: "Usage",
					Content: codeContent("go", `@atoms.Flex(atoms.FlexProps{Gap: components.Gap4}) {
    @atoms.Button(atoms.ButtonProps{Text: "Save"})
    @atoms.Button(atoms.ButtonProps{
        Text: "Cancel",
        Variant: components.ButtonOutline,
    })
}`),
				})
			}
		}
	}
}

// Helper components
templ statsCardContent(icon, value, label string) {
	@atoms.Flex(atoms.FlexProps{
		Direction: components.FlexCol,
		Align:     components.AlignCenter,
		Gap:       components.Gap4,
	}) {
		@atoms.Text(atoms.TextProps{
			Content: icon,
			Size:    components.Text4XL,
		})
		@atoms.Text(atoms.TextProps{
			Content: value,
			Size:    components.Text2XL,
			Weight:  components.WeightBold,
		})
		@atoms.Text(atoms.TextProps{
			Content: label,
			Color:   components.ColorMuted,
			Size:    components.TextSm,
		})
	}
}

templ cardContent(content string) {
	@atoms.Text(atoms.TextProps{
		Content: content,
	})
}

templ codeContent(lang, code string) {
	@atoms.Code(atoms.CodeProps{
		Content: code,
		Language: lang,
		Block:   true,
	})
}