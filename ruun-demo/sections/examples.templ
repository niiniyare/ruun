package sections

import (
    "github.com/a-h/templ"
    "github.com/niiniyare/ruun/views/components/atoms"
    "github.com/niiniyare/ruun/views/components/molecules"
    "github.com/niiniyare/ruun/views/components"
)

templ ExamplesPage() {
    @DemoLayout("Examples", "examples") {
        <div class="space-y-8">
            @atoms.Heading(atoms.HeadingProps{Level: 1, Text: "Real-World Examples"})
            @atoms.Text(atoms.TextProps{
                Text: "Complete, production-ready implementations showcasing component combinations.",
                Variant: atoms.TextMuted,
            })
            
            // ════════════════════════════════════════════════════════════
            // USER PROFILE EXAMPLE  
            // ════════════════════════════════════════════════════════════
            @Section("User Profile Form") {
                @atoms.Text(atoms.TextProps{
                    Text: "Complete user profile form with validation and image upload:",
                    Variant: atoms.TextMuted,
                })
                
                @userProfileExample()
                
                @CodeBlock(`// User Profile Form
@molecules.Card(molecules.CardProps{
    Title: "Profile Settings",
    Description: "Update your personal information",
    Content: profileForm(),
})`)
            }
            
            // ════════════════════════════════════════════════════════════
            // DASHBOARD STATS EXAMPLE
            // ════════════════════════════════════════════════════════════
            @Section("Dashboard Statistics") {
                @atoms.Text(atoms.TextProps{
                    Text: "Dashboard with metrics cards and action buttons:",
                    Variant: atoms.TextMuted,
                })
                
                @dashboardStatsExample()
                
                @CodeBlock(`// Dashboard Stats Layout
@atoms.Grid(atoms.GridProps{Cols: 4, Gap: "gap-6"}) {
    @molecules.StatsCard("Total Users", "1,234", "+12%", true)
    @molecules.StatsCard("Revenue", "$45,678", "+8%", true)
    @molecules.StatsCard("Orders", "892", "-3%", false)
    @molecules.StatsCard("Conversion", "3.2%", "+1.1%", true)
}`)
            }
            
            // ════════════════════════════════════════════════════════════
            // SEARCH AND FILTERS EXAMPLE
            // ════════════════════════════════════════════════════════════
            @Section("Search & Filter Interface") {
                @atoms.Text(atoms.TextProps{
                    Text: "Advanced search with filters and results:",
                    Variant: atoms.TextMuted,
                })
                
                @searchFiltersExample()
                
                @CodeBlock(`// Search Interface
@atoms.Flex(atoms.FlexProps{Gap: "gap-4"}) {
    @molecules.SearchBox(molecules.SearchBoxProps{
        Placeholder: "Search products...",
        Suggestions: suggestions,
    })
    @molecules.DropdownMenu(filterMenu)
    @atoms.Button(atoms.ButtonProps{
        Text: "Filter",
        Variant: components.ButtonSecondary,
    })
}`)
            }
            
            // ════════════════════════════════════════════════════════════
            // NOTIFICATION CENTER EXAMPLE
            // ════════════════════════════════════════════════════════════
            @Section("Notification Center") {
                @atoms.Text(atoms.TextProps{
                    Text: "Notification management with different types and actions:",
                    Variant: atoms.TextMuted,
                })
                
                @notificationCenterExample()
                
                @CodeBlock(`// Notification Center
@molecules.Card(molecules.CardProps{
    Title: "Notifications",
    HeaderAction: markAllReadButton(),
}) {
    @notificationList(notifications)
}`)
            }
        </div>
    }
}

// Example implementations
templ userProfileExample() {
    @molecules.Card(molecules.CardProps{
        Title: "Profile Settings",
        Description: "Update your personal information",
    }) {
        <div class="space-y-6">
            @atoms.Flex(atoms.FlexProps{Gap: atoms.Gap6}) {
                @atoms.Avatar(atoms.AvatarProps{
                    Src: "https://github.com/shadcn.png",
                    Alt: "Profile picture",
                    Size: components.SizeLg,
                })
                <div class="flex-1 space-y-4">
                    @molecules.FormField(molecules.FormFieldProps{
                        Label: "Full Name",
                        Name: "name",
                        Type: "text",
                        Value: "John Doe",
                        Required: true,
                    })
                    @molecules.FormField(molecules.FormFieldProps{
                        Label: "Email",
                        Name: "email",
                        Type: "email",
                        Value: "john.doe@example.com",
                        Required: true,
                    })
                </div>
            }
            
            @atoms.Flex(atoms.FlexProps{Gap: atoms.Gap2, Justify: atoms.JustifyEnd}) {
                @atoms.Button(atoms.ButtonProps{
                    Text: "Cancel",
                    Variant: components.ButtonSecondary,
                })
                @atoms.Button(atoms.ButtonProps{
                    Text: "Save Changes",
                    Variant: components.ButtonPrimary,
                })
            }
        </div>
    }
}

templ dashboardStatsExample() {
    @atoms.Grid(atoms.GridProps{Cols: 4, Gap: "gap-6"}) {
        @molecules.StatsCard("Total Users", "1,234", "+12%", "users", "", true)
        @molecules.StatsCard("Revenue", "$45,678", "+8%", "dollar-sign", "", true)
        @molecules.StatsCard("Orders", "892", "-3%", "shopping-cart", "", false)
        @molecules.StatsCard("Conversion", "3.2%", "+1.1%", "trending-up", "", true)
    }
}

templ searchFiltersExample() {
    <div class="space-y-4">
        @atoms.Flex(atoms.FlexProps{Gap: "gap-4", Align: "items-center"}) {
            <div class="flex-1">
                @molecules.SearchBox(molecules.SearchBoxProps{
                    ID: "search",
                    Name: "search",
                    Placeholder: "Search products...",
                })
            </div>
            @molecules.SimpleDropdownMenu("filters", "Filters", []molecules.DropdownMenuItem{
                {Text: "All Categories", Type: "radio", Checked: true},
                {Text: "Electronics", Type: "radio"},
                {Text: "Clothing", Type: "radio"},
                {Text: "Books", Type: "radio"},
            })
            @atoms.Button(atoms.ButtonProps{
                Text: "Search",
                Variant: components.ButtonPrimary,
            })
        }
        
        <div class="border border-border rounded-lg p-4">
            <p class="text-sm text-muted-foreground mb-2">Search Results:</p>
            <div class="space-y-2">
                <div class="flex justify-between items-center p-2 hover:bg-muted rounded">
                    <span>iPhone 13 Pro Max</span>
                    <span class="text-muted-foreground">$1,099</span>
                </div>
                <div class="flex justify-between items-center p-2 hover:bg-muted rounded">
                    <span>Samsung Galaxy S22</span>
                    <span class="text-muted-foreground">$799</span>
                </div>
                <div class="flex justify-between items-center p-2 hover:bg-muted rounded">
                    <span>MacBook Pro 14"</span>
                    <span class="text-muted-foreground">$1,999</span>
                </div>
            </div>
        </div>
    </div>
}

templ notificationCenterExample() {
    @molecules.Card(molecules.CardProps{
        Title: "Notifications",
        HeaderAction: atoms.Button(atoms.ButtonProps{
            Text: "Mark all read",
            Size: components.SizeSm,
            Variant: components.ButtonSecondary,
        }),
    }) {
        <div class="space-y-3">
            <div class="flex gap-3 p-3 bg-primary/5 border border-primary/20 rounded-lg">
                @atoms.Icon(atoms.IconProps{Name: "mail", Size: components.SizeSm})
                <div class="flex-1">
                    <p class="text-sm font-medium">New message from Sarah</p>
                    <p class="text-xs text-muted-foreground">2 minutes ago</p>
                </div>
                @atoms.Button(atoms.ButtonProps{
                    Text: "Reply",
                    Size: components.SizeSm,
                    Variant: components.ButtonSecondary,
                })
            </div>
            
            <div class="flex gap-3 p-3 hover:bg-muted rounded-lg">
                @atoms.Icon(atoms.IconProps{Name: "bell", Size: components.SizeSm})
                <div class="flex-1">
                    <p class="text-sm font-medium">Server maintenance scheduled</p>
                    <p class="text-xs text-muted-foreground">1 hour ago</p>
                </div>
            </div>
            
            <div class="flex gap-3 p-3 hover:bg-muted rounded-lg">
                @atoms.Icon(atoms.IconProps{Name: "check-circle", Size: components.SizeSm})
                <div class="flex-1">
                    <p class="text-sm font-medium">Deployment completed successfully</p>
                    <p class="text-xs text-muted-foreground">3 hours ago</p>
                </div>
            </div>
        </div>
    }
}