package sections

import (
	"github.com/a-h/templ"
	"github.com/niiniyare/ruun/views/components/atoms"
	"github.com/niiniyare/ruun/views/components/molecules"
	"github.com/niiniyare/ruun/views/components/templates"
	"github.com/niiniyare/ruun/views/components"
)

templ TemplatesPage() {
	@DemoLayout("Templates", "templates") {
		<div class="space-y-8">
			@atoms.Heading(atoms.HeadingProps{Level: 1, Text: "Templates"})
			@atoms.Text(atoms.TextProps{
				Text: "Complete page layouts for different application types.",
				Variant: atoms.TextMuted,
			})

			// ════════════════════════════════════════════════════════════
			// PAGE LAYOUTS
			// ════════════════════════════════════════════════════════════
			@Section("Page Layouts") {
				@atoms.Grid(atoms.GridProps{Cols: 2, Gap: atoms.Gap6}) {
					// Sidebar Layout
					@molecules.Card(molecules.CardProps{
						Title:       "Sidebar Layout",
						Description: "Layout with fixed sidebar navigation",
						Content:     sidebarLayoutPreview(),
					})

					// Topbar Layout
					@molecules.Card(molecules.CardProps{
						Title:       "Topbar Layout",
						Description: "Layout with top navigation bar",
						Content:     topbarLayoutPreview(),
					})

					// Combined Layout
					@molecules.Card(molecules.CardProps{
						Title:       "Combined Layout",
						Description: "Layout with both sidebar and topbar",
						Content:     combinedLayoutPreview(),
					})

					// Fullscreen Layout
					@molecules.Card(molecules.CardProps{
						Title:       "Fullscreen Layout",
						Description: "Clean fullscreen layout without chrome",
						Content:     fullscreenLayoutPreview(),
					})
				}
			}

			// ════════════════════════════════════════════════════════════
			// DASHBOARD LAYOUTS
			// ════════════════════════════════════════════════════════════
			@Section("Dashboard Layouts") {
				@atoms.Grid(atoms.GridProps{Cols: 2, Gap: atoms.Gap6}) {
					// Analytics Dashboard
					@molecules.Card(molecules.CardProps{
						Title:       "Analytics Dashboard",
						Description: "Dashboard focused on metrics and charts",
						Content:     analyticsDashboardPreview(),
					})

					// Overview Dashboard
					@molecules.Card(molecules.CardProps{
						Title:       "Overview Dashboard",
						Description: "General overview dashboard layout",
						Content:     overviewDashboardPreview(),
					})
				}
			}

			// ════════════════════════════════════════════════════════════
			// LAYOUT EXAMPLES
			// ════════════════════════════════════════════════════════════
			@Section("Example Implementations") {
				<div class="space-y-6">
					<div>
						@atoms.Text(atoms.TextProps{Text: "Sidebar Layout Example", Weight: atoms.WeightMedium})
						@templates.ExampleSidebarLayout()
					</div>

					<div>
						@atoms.Text(atoms.TextProps{Text: "Analytics Dashboard Example", Weight: atoms.WeightMedium})
						@templates.ExampleAnalyticsDashboard()
					</div>

					<div>
						@atoms.Text(atoms.TextProps{Text: "Topbar Layout Example", Weight: atoms.WeightMedium})
						@templates.ExampleTopbarLayout()
					</div>

					<div>
						@atoms.Text(atoms.TextProps{Text: "Fullscreen Layout Example", Weight: atoms.WeightMedium})
						@templates.ExampleFullscreenLayout()
					</div>
				</div>
			}

			// ════════════════════════════════════════════════════════════
			// BASE LAYOUT
			// ════════════════════════════════════════════════════════════
			@Section("Base Layout Features") {
				<div class="space-y-4">
					@atoms.Text(atoms.TextProps{
						Text: "The BaseLayout template provides essential page structure including:",
					})
					<ul class="list-disc list-inside space-y-2 text-muted-foreground">
						<li>HTML document structure with proper meta tags</li>
						<li>Theme configuration and dark mode support</li>
						<li>HTMX and Alpine.js integration</li>
						<li>Custom CSS and JavaScript resource loading</li>
						<li>Page loader components</li>
						<li>Responsive design foundations</li>
					</ul>

					@atoms.Box(atoms.BoxProps{Class: "mt-6 p-4 bg-muted rounded-lg"}) {
						@atoms.Code(atoms.CodeProps{
							Text: `@templates.BaseLayout(templates.BaseLayoutProps{
	Meta: templates.PageMeta{
		Title: "My Application",
		Description: "A powerful web application",
		Keywords: []string{"web", "app", "golang"},
	},
	Theme: templates.ThemeConfig{
		DarkMode: true,
		SystemSync: true,
	},
}) {
	// Your page content here
}`,
							Variant: components.CodeBlock,
						})
					}
				</div>
			}
		</div>
	}
}

// Preview components for different layouts
templ sidebarLayoutPreview() {
	<div class="bg-muted rounded-md p-4 h-32">
		<div class="flex h-full">
			<div class="w-16 bg-background rounded mr-2"></div>
			<div class="flex-1 bg-background rounded">
				<div class="h-6 bg-muted rounded m-2"></div>
				<div class="h-4 bg-muted rounded m-2 w-3/4"></div>
				<div class="h-4 bg-muted rounded m-2 w-1/2"></div>
			</div>
		</div>
	</div>
}

templ topbarLayoutPreview() {
	<div class="bg-muted rounded-md p-4 h-32">
		<div class="h-full">
			<div class="h-8 bg-background rounded mb-2"></div>
			<div class="flex-1 bg-background rounded h-20">
				<div class="h-6 bg-muted rounded m-2"></div>
				<div class="h-4 bg-muted rounded m-2 w-3/4"></div>
				<div class="h-4 bg-muted rounded m-2 w-1/2"></div>
			</div>
		</div>
	</div>
}

templ combinedLayoutPreview() {
	<div class="bg-muted rounded-md p-4 h-32">
		<div class="h-full">
			<div class="h-6 bg-background rounded mb-2"></div>
			<div class="flex flex-1 h-20">
				<div class="w-12 bg-background rounded mr-2"></div>
				<div class="flex-1 bg-background rounded">
					<div class="h-4 bg-muted rounded m-2"></div>
					<div class="h-4 bg-muted rounded m-2 w-2/3"></div>
				</div>
			</div>
		</div>
	</div>
}

templ fullscreenLayoutPreview() {
	<div class="bg-muted rounded-md p-4 h-32">
		<div class="h-full bg-background rounded">
			<div class="h-8 bg-muted rounded m-2"></div>
			<div class="h-4 bg-muted rounded m-2 w-3/4"></div>
			<div class="h-4 bg-muted rounded m-2 w-1/2"></div>
			<div class="h-4 bg-muted rounded m-2 w-5/6"></div>
		</div>
	</div>
}

templ analyticsDashboardPreview() {
	<div class="bg-muted rounded-md p-4 h-32">
		<div class="grid grid-cols-3 gap-2 h-full">
			<div class="bg-background rounded">
				<div class="h-3 bg-muted rounded m-1"></div>
				<div class="h-6 bg-muted rounded m-1"></div>
			</div>
			<div class="bg-background rounded">
				<div class="h-3 bg-muted rounded m-1"></div>
				<div class="h-6 bg-muted rounded m-1"></div>
			</div>
			<div class="bg-background rounded">
				<div class="h-3 bg-muted rounded m-1"></div>
				<div class="h-6 bg-muted rounded m-1"></div>
			</div>
		</div>
	</div>
}

templ overviewDashboardPreview() {
	<div class="bg-muted rounded-md p-4 h-32">
		<div class="h-full">
			<div class="flex gap-2 mb-2">
				<div class="w-1/2 h-12 bg-background rounded"></div>
				<div class="w-1/2 h-12 bg-background rounded"></div>
			</div>
			<div class="h-16 bg-background rounded">
				<div class="h-3 bg-muted rounded m-2"></div>
				<div class="h-3 bg-muted rounded m-2 w-3/4"></div>
			</div>
		</div>
	</div>
}