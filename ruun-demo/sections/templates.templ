package sections

import "github.com/ruun-io/ruun/views/components/atoms"
import "github.com/ruun-io/ruun/views/components/molecules"
import "github.com/ruun-io/ruun/views/components/organisms"

templ Templates() {
	<section class="container mx-auto px-6 py-12">
		<div class="text-center mb-12">
			<h2 class="text-3xl font-bold mb-4">Page Templates</h2>
			<p class="text-gray-600 text-lg">Complete page layouts for different application types</p>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16">
			// PageLayout Showcase
			@organisms.Card(organisms.CardProps{
				Title:       "PageLayout",
				Description: "Base page layout with multiple layout types",
				Content: pageLayoutShowcase(),
				ClassName:   "h-full",
			})

			// DashboardLayout Showcase
			@organisms.Card(organisms.CardProps{
				Title:       "DashboardLayout", 
				Description: "Advanced dashboard layout with widgets and metrics",
				Content: dashboardLayoutShowcase(),
				ClassName:   "h-full",
			})

			// BaseLayout Showcase
			@organisms.Card(organisms.CardProps{
				Title:       "BaseLayout",
				Description: "Foundation HTML layout with theme integration",
				Content: baseLayoutShowcase(),
				ClassName:   "h-full",
			})

			// AuthLayout Showcase (Future)
			@organisms.Card(organisms.CardProps{
				Title:       "AuthLayout",
				Description: "Centered card layout for authentication pages",
				Content: authLayoutShowcase(),
				ClassName:   "h-full",
			})

			// FormLayout Showcase (Future)
			@organisms.Card(organisms.CardProps{
				Title:       "FormLayout", 
				Description: "Centered form layout for data entry pages",
				Content: formLayoutShowcase(),
				ClassName:   "h-full",
			})

			// ErrorLayout Showcase (Future)
			@organisms.Card(organisms.CardProps{
				Title:       "ErrorLayout",
				Description: "Error page layout for 404, 500, and other errors",
				Content: errorLayoutShowcase(),
				ClassName:   "h-full",
			})
		</div>

		// Template Comparison Section
		<div class="bg-gray-50 rounded-lg p-8">
			<h3 class="text-2xl font-bold mb-6 text-center">Template Comparison</h3>
			
			@organisms.Table(organisms.TableProps{
				Headers: []string{"Template", "Use Case", "Layout Type", "Features", "Status"},
				Rows: []organisms.TableRow{
					{
						Cells: []string{"PageLayout", "General pages", "Sidebar/Topbar/Combined/Fullscreen", "Navigation, breadcrumbs, actions", "Available"},
						ClassName: "",
					},
					{
						Cells: []string{"DashboardLayout", "Analytics & dashboards", "Grid-based with widgets", "Metrics, charts, tables, real-time data", "Available"},
						ClassName: "",
					},
					{
						Cells: []string{"BaseLayout", "HTML foundation", "Base HTML structure", "Theme integration, meta tags, scripts", "Available"},
						ClassName: "",
					},
					{
						Cells: []string{"AuthLayout", "Authentication", "Centered card", "Login, register, forgot password", "Planned"},
						ClassName: "opacity-60",
					},
					{
						Cells: []string{"FormLayout", "Data entry", "Centered form", "Multi-step forms, validation", "Planned"},
						ClassName: "opacity-60",
					},
					{
						Cells: []string{"ErrorLayout", "Error pages", "Centered message", "404, 500, custom errors", "Planned"},
						ClassName: "opacity-60",
					},
				},
				ClassName: "w-full",
			})
		</div>
	</section>
}

templ pageLayoutShowcase() {
	<div class="space-y-4">
		<div class="grid grid-cols-2 gap-4">
			// Layout Types
			@molecules.Badge(molecules.BadgeProps{
				Text:    "Sidebar",
				Variant: molecules.BadgeVariantSecondary,
				Size:    molecules.BadgeSizeSmall,
			})
			@molecules.Badge(molecules.BadgeProps{
				Text:    "Topbar",
				Variant: molecules.BadgeVariantSecondary,
				Size:    molecules.BadgeSizeSmall,
			})
			@molecules.Badge(molecules.BadgeProps{
				Text:    "Combined",
				Variant: molecules.BadgeVariantSecondary,
				Size:    molecules.BadgeSizeSmall,
			})
			@molecules.Badge(molecules.BadgeProps{
				Text:    "Fullscreen",
				Variant: molecules.BadgeVariantSecondary,
				Size:    molecules.BadgeSizeSmall,
			})
		</div>

		<div class="text-sm text-gray-600 space-y-2">
			<p>• Flexible navigation configuration</p>
			<p>• Breadcrumb and action support</p>
			<p>• HTMX and Alpine.js integration</p>
			<p>• Theme and responsive design</p>
		</div>

		// Visual Preview
		<div class="border rounded-md p-3 bg-gray-50">
			<div class="flex">
				<div class="w-16 h-12 bg-blue-200 rounded-sm mr-2"></div>
				<div class="flex-1 space-y-1">
					<div class="h-3 bg-gray-300 rounded w-3/4"></div>
					<div class="h-2 bg-gray-200 rounded w-1/2"></div>
				</div>
			</div>
		</div>

		@atoms.Button(atoms.ButtonProps{
			Text:    "View Examples",
			Variant: atoms.ButtonVariantPrimary,
			Size:    atoms.ButtonSizeSmall,
		})
	</div>
}

templ dashboardLayoutShowcase() {
	<div class="space-y-4">
		<div class="grid grid-cols-2 gap-2">
			@molecules.Badge(molecules.BadgeProps{
				Text:    "Metrics",
				Variant: molecules.BadgeVariantSuccess,
				Size:    molecules.BadgeSizeSmall,
			})
			@molecules.Badge(molecules.BadgeProps{
				Text:    "Charts",
				Variant: molecules.BadgeVariantSuccess,
				Size:    molecules.BadgeSizeSmall,
			})
			@molecules.Badge(molecules.BadgeProps{
				Text:    "Tables",
				Variant: molecules.BadgeVariantSuccess,
				Size:    molecules.BadgeSizeSmall,
			})
			@molecules.Badge(molecules.BadgeProps{
				Text:    "Real-time",
				Variant: molecules.BadgeVariantSuccess,
				Size:    molecules.BadgeSizeSmall,
			})
		</div>

		<div class="text-sm text-gray-600 space-y-2">
			<p>• Grid-based widget system</p>
			<p>• Analytics & reporting sections</p>
			<p>• WebSocket integration</p>
			<p>• Export and filtering</p>
		</div>

		// Visual Preview
		<div class="border rounded-md p-3 bg-gray-50">
			<div class="grid grid-cols-2 gap-2 mb-2">
				<div class="h-6 bg-green-200 rounded-sm"></div>
				<div class="h-6 bg-blue-200 rounded-sm"></div>
			</div>
			<div class="h-8 bg-purple-200 rounded-sm"></div>
		</div>

		@atoms.Button(atoms.ButtonProps{
			Text:    "View Dashboard",
			Variant: atoms.ButtonVariantPrimary,
			Size:    atoms.ButtonSizeSmall,
		})
	</div>
}

templ baseLayoutShowcase() {
	<div class="space-y-4">
		<div class="grid grid-cols-2 gap-2">
			@molecules.Badge(molecules.BadgeProps{
				Text:    "Theme",
				Variant: molecules.BadgeVariantOutline,
				Size:    molecules.BadgeSizeSmall,
			})
			@molecules.Badge(molecules.BadgeProps{
				Text:    "Meta",
				Variant: molecules.BadgeVariantOutline,
				Size:    molecules.BadgeSizeSmall,
			})
			@molecules.Badge(molecules.BadgeProps{
				Text:    "Scripts",
				Variant: molecules.BadgeVariantOutline,
				Size:    molecules.BadgeSizeSmall,
			})
			@molecules.Badge(molecules.BadgeProps{
				Text:    "HTMX",
				Variant: molecules.BadgeVariantOutline,
				Size:    molecules.BadgeSizeSmall,
			})
		</div>

		<div class="text-sm text-gray-600 space-y-2">
			<p>• HTML foundation structure</p>
			<p>• Theme system integration</p>
			<p>• Custom CSS/JS loading</p>
			<p>• Dark mode support</p>
		</div>

		// Visual Preview
		<div class="border rounded-md p-3 bg-gray-50">
			<div class="text-xs font-mono text-gray-500">
				<div>&lt;html&gt;</div>
				<div class="ml-2">&lt;head&gt;...&lt;/head&gt;</div>
				<div class="ml-2">&lt;body&gt;...&lt;/body&gt;</div>
				<div>&lt;/html&gt;</div>
			</div>
		</div>

		@atoms.Button(atoms.ButtonProps{
			Text:    "View Structure",
			Variant: atoms.ButtonVariantSecondary,
			Size:    atoms.ButtonSizeSmall,
		})
	</div>
}

templ authLayoutShowcase() {
	<div class="space-y-4">
		<div class="grid grid-cols-2 gap-2">
			@molecules.Badge(molecules.BadgeProps{
				Text:    "Coming Soon",
				Variant: molecules.BadgeVariantWarning,
				Size:    molecules.BadgeSizeSmall,
			})
		</div>

		<div class="text-sm text-gray-600 space-y-2">
			<p>• Centered card layout</p>
			<p>• Login & registration forms</p>
			<p>• Password recovery flows</p>
			<p>• Social authentication</p>
		</div>

		// Visual Preview
		<div class="border rounded-md p-3 bg-gray-50">
			<div class="flex justify-center">
				<div class="w-20 h-16 bg-gray-300 rounded border-2 border-dashed border-gray-400"></div>
			</div>
		</div>

		@atoms.Button(atoms.ButtonProps{
			Text:    "Planned",
			Variant: atoms.ButtonVariantSecondary,
			Size:    atoms.ButtonSizeSmall,
			Disabled: true,
		})
	</div>
}

templ formLayoutShowcase() {
	<div class="space-y-4">
		<div class="grid grid-cols-2 gap-2">
			@molecules.Badge(molecules.BadgeProps{
				Text:    "Coming Soon",
				Variant: molecules.BadgeVariantWarning,
				Size:    molecules.BadgeSizeSmall,
			})
		</div>

		<div class="text-sm text-gray-600 space-y-2">
			<p>• Centered form layout</p>
			<p>• Multi-step form support</p>
			<p>• Validation integration</p>
			<p>• Progress indicators</p>
		</div>

		// Visual Preview
		<div class="border rounded-md p-3 bg-gray-50">
			<div class="space-y-2">
				<div class="h-2 bg-gray-300 rounded w-full"></div>
				<div class="h-2 bg-gray-300 rounded w-3/4"></div>
				<div class="h-2 bg-gray-300 rounded w-1/2"></div>
			</div>
		</div>

		@atoms.Button(atoms.ButtonProps{
			Text:    "Planned",
			Variant: atoms.ButtonVariantSecondary,
			Size:    atoms.ButtonSizeSmall,
			Disabled: true,
		})
	</div>
}

templ errorLayoutShowcase() {
	<div class="space-y-4">
		<div class="grid grid-cols-2 gap-2">
			@molecules.Badge(molecules.BadgeProps{
				Text:    "Coming Soon",
				Variant: molecules.BadgeVariantWarning,
				Size:    molecules.BadgeSizeSmall,
			})
		</div>

		<div class="text-sm text-gray-600 space-y-2">
			<p>• Error-specific layouts</p>
			<p>• 404, 500 error pages</p>
			<p>• Custom error handling</p>
			<p>• Recovery actions</p>
		</div>

		// Visual Preview
		<div class="border rounded-md p-3 bg-gray-50">
			<div class="text-center">
				<div class="text-2xl text-red-400">⚠️</div>
				<div class="h-1 bg-red-200 rounded w-16 mx-auto mt-2"></div>
			</div>
		</div>

		@atoms.Button(atoms.ButtonProps{
			Text:    "Planned",
			Variant: atoms.ButtonVariantSecondary,
			Size:    atoms.ButtonSizeSmall,
			Disabled: true,
		})
	</div>
}