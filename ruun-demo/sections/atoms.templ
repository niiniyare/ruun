package sections

import (
    "github.com/a-h/templ"
    "github.com/niiniyare/ruun/views/components/atoms"
    "github.com/niiniyare/ruun/views/components/molecules"
    "github.com/niiniyare/ruun/views/components"
)

templ AtomsPage() {
    @DemoLayout("Atoms", "atoms") {
        <div class="space-y-8">
            @atoms.Heading(atoms.HeadingProps{Level: 1, Text: "Atoms"})
            @atoms.Text(atoms.TextProps{
                Text: "Basic building blocks. Each atom is a single-purpose component.",
                Variant: atoms.TextMuted,
            })
            
            // ════════════════════════════════════════════════════════════
            // LAYOUT PRIMITIVES
            // ════════════════════════════════════════════════════════════
            @Section("Layout: Flex") {
                <div class="space-y-6">
                    @atoms.Text(atoms.TextProps{Text: "Row with gap", Weight: atoms.WeightMedium})
                    @atoms.Flex(atoms.FlexProps{Gap: atoms.Gap4}) {
                        @atoms.Box(atoms.BoxProps{Class: "p-4 bg-muted rounded-md"}) {
                            @atoms.Text(atoms.TextProps{Text: "Item 1"})
                        }
                        @atoms.Box(atoms.BoxProps{Class: "p-4 bg-muted rounded-md"}) {
                            @atoms.Text(atoms.TextProps{Text: "Item 2"})
                        }
                        @atoms.Box(atoms.BoxProps{Class: "p-4 bg-muted rounded-md"}) {
                            @atoms.Text(atoms.TextProps{Text: "Item 3"})
                        }
                    }
                    
                    @atoms.Text(atoms.TextProps{Text: "Justify between", Weight: atoms.WeightMedium})
                    @atoms.Flex(atoms.FlexProps{Justify: atoms.JustifyBetween}) {
                        @atoms.Button(atoms.ButtonProps{Text: "Left"})
                        @atoms.Button(atoms.ButtonProps{Text: "Right"})
                    }
                    
                    @atoms.Text(atoms.TextProps{Text: "Align center", Weight: atoms.WeightMedium})
                    @atoms.Flex(atoms.FlexProps{Gap: atoms.Gap4, Align: atoms.AlignCenter}) {
                        @atoms.Avatar(atoms.AvatarProps{Initials: "JD", Size: components.SizeLg})
                        <div class="space-y-1">
                            @atoms.Text(atoms.TextProps{Text: "John Doe", Weight: atoms.WeightMedium})
                            @atoms.Text(atoms.TextProps{Text: "john@example.com", Size: atoms.TextSm, Variant: atoms.TextMuted})
                        </div>
                    }
                </div>
            }
            
            @Section("Layout: Grid") {
                @atoms.Grid(atoms.GridProps{Cols: 3, Gap: atoms.Gap4}) {
                    @atoms.Box(atoms.BoxProps{Class: "p-4 bg-muted rounded-md"}) {
                        @atoms.Text(atoms.TextProps{Text: "Col 1"})
                    }
                    @atoms.Box(atoms.BoxProps{Class: "p-4 bg-muted rounded-md"}) {
                        @atoms.Text(atoms.TextProps{Text: "Col 2"})
                    }
                    @atoms.Box(atoms.BoxProps{Class: "p-4 bg-muted rounded-md"}) {
                        @atoms.Text(atoms.TextProps{Text: "Col 3"})
                    }
                }
            }
            
            @Section("Layout: Stack") {
                @atoms.Stack(atoms.StackProps{Gap: atoms.Gap4}) {
                    @atoms.Text(atoms.TextProps{Text: "Item 1"})
                    @atoms.Text(atoms.TextProps{Text: "Item 2"})
                    @atoms.Text(atoms.TextProps{Text: "Item 3"})
                }
            }
            
            @Section("Layout: Center") {
                @atoms.Center(atoms.CenterProps{Class: "max-w-md"}) {
                    @atoms.Box(atoms.BoxProps{Class: "p-4 bg-muted rounded-md"}) {
                        @atoms.Text(atoms.TextProps{Text: "Centered content with max width"})
                    }
                }
            }
            
            @Section("Layout: Box") {
                @atoms.Grid(atoms.GridProps{Cols: 3, Gap: atoms.Gap4}) {
                    @atoms.Box(atoms.BoxProps{
                        Class: "p-4 border border-border rounded-lg",
                    }) {
                        @atoms.Text(atoms.TextProps{Text: "Border"})
                    }
                    @atoms.Box(atoms.BoxProps{
                        Class: "p-4 bg-muted rounded-lg",
                    }) {
                        @atoms.Text(atoms.TextProps{Text: "Background"})
                    }
                    @atoms.Box(atoms.BoxProps{
                        Class: "p-4 shadow-md rounded-lg",
                    }) {
                        @atoms.Text(atoms.TextProps{Text: "Shadow"})
                    }
                }
            }
            
            @Section("Layout: Spacer") {
                @atoms.Box(atoms.BoxProps{Class: "border border-border p-4 rounded-md"}) {
                    @atoms.Text(atoms.TextProps{Text: "Top"})
                    @atoms.Spacer(atoms.SpacerProps{Class: "h-8"})
                    @atoms.Text(atoms.TextProps{Text: "Bottom"})
                }
            }
            
            // ════════════════════════════════════════════════════════════
            // BUTTONS
            // ════════════════════════════════════════════════════════════
            @Section("Button Variants") {
                @atoms.Flex(atoms.FlexProps{Gap: atoms.Gap4, Wrap: atoms.Wrap}) {
                    @atoms.Button(atoms.ButtonProps{Text: "Default"})
                    @atoms.Button(atoms.ButtonProps{Text: "Secondary", Variant: components.ButtonSecondary})
                    @atoms.Button(atoms.ButtonProps{Text: "Outline", Variant: components.ButtonOutline})
                    @atoms.Button(atoms.ButtonProps{Text: "Destructive", Variant: components.ButtonDestructive})
                    @atoms.Button(atoms.ButtonProps{Text: "Ghost", Variant: components.ButtonGhost})
                    @atoms.Button(atoms.ButtonProps{Text: "Link", Variant: components.ButtonLink})
                }
            }
            
            @Section("Button Sizes") {
                @atoms.Flex(atoms.FlexProps{Gap: atoms.Gap4, Align: atoms.AlignCenter}) {
                    @atoms.Button(atoms.ButtonProps{Text: "Small", Size: components.SizeSm})
                    @atoms.Button(atoms.ButtonProps{Text: "Default", Size: components.SizeDefault})
                    @atoms.Button(atoms.ButtonProps{Text: "Large", Size: components.SizeLg})
                }
            }
            
            @Section("Button States") {
                @atoms.Flex(atoms.FlexProps{Gap: atoms.Gap4}) {
                    @atoms.Button(atoms.ButtonProps{Text: "Disabled", Attrs: templ.Attributes{"disabled": ""}})
                    @atoms.Button(atoms.ButtonProps{Text: "Loading"})
                }
            }
            
            @Section("Button with Icons") {
                @atoms.Flex(atoms.FlexProps{Gap: atoms.Gap4}) {
                    @atoms.Button(atoms.ButtonProps{
                        Text: "Settings",
                    })
                    @atoms.Button(atoms.ButtonProps{
                        Text: "Next", 
                    })
                    @atoms.Button(atoms.ButtonProps{
                        Text: "Add",
                    })
                }
            }
            
            // ════════════════════════════════════════════════════════════
            // FORM INPUTS
            // ════════════════════════════════════════════════════════════
            @Section("Input Types") {
                @atoms.Grid(atoms.GridProps{Cols: 2, Gap: atoms.Gap4}) {
                    @atoms.Input(atoms.InputProps{
                        Type: components.InputText,
                        Placeholder: "Text input",
                    })
                    @atoms.Input(atoms.InputProps{
                        Type: components.InputEmail,
                        Placeholder: "Email",
                    })
                    @atoms.Input(atoms.InputProps{
                        Type: components.InputPassword,
                        Placeholder: "Password",
                    })
                    @atoms.Input(atoms.InputProps{
                        Type: components.InputNumber,
                        Placeholder: "Number",
                    })
                    @atoms.Input(atoms.InputProps{
                        Type: components.InputSearch,
                        Placeholder: "Search",
                    })
                    @atoms.Input(atoms.InputProps{
                        Type: components.InputTel,
                        Placeholder: "Phone",
                    })
                    @atoms.Input(atoms.InputProps{
                        Type: components.InputUrl,
                        Placeholder: "URL",
                    })
                    @atoms.Input(atoms.InputProps{
                        Type: components.InputDate,
                        Placeholder: "Date",
                    })
                }
            }
            
            @Section("Input States") {
                @atoms.Grid(atoms.GridProps{Cols: 2, Gap: atoms.Gap4}) {
                    @atoms.Input(atoms.InputProps{Placeholder: "Default"})
                    @atoms.Input(atoms.InputProps{Placeholder: "Disabled", Disabled: true})
                    @atoms.Input(atoms.InputProps{Value: "Readonly", Readonly: true})
                    @atoms.Input(atoms.InputProps{Placeholder: "Error", Invalid: true})
                }
            }
            
            @Section("Textarea") {
                <div class="space-y-4">
                    @atoms.Box(atoms.BoxProps{Class: "max-w-md"}) {
                        @atoms.Textarea(atoms.TextareaProps{
                            Placeholder: "Default textarea",
                            Rows: 3,
                        })
                    }
                    @atoms.Box(atoms.BoxProps{Class: "max-w-md"}) {
                        @atoms.Textarea(atoms.TextareaProps{
                            Placeholder: "Disabled textarea",
                            Rows: 3,
                            Disabled: true,
                        })
                    }
                    @atoms.Box(atoms.BoxProps{Class: "max-w-md"}) {
                        @atoms.Textarea(atoms.TextareaProps{
                            Placeholder: "Error textarea",
                            Rows: 3,
                            Invalid: true,
                        })
                    }
                </div>
            }
            
            @Section("Select") {
                @atoms.Grid(atoms.GridProps{Cols: 2, Gap: atoms.Gap4}) {
                    @atoms.Select(atoms.SelectProps{
                        Placeholder: "Select an option",
                        Options: []atoms.SelectOption{
                            {Value: "1", Label: "Option 1"},
                            {Value: "2", Label: "Option 2"},
                            {Value: "3", Label: "Option 3"},
                        },
                    })
                    @atoms.Select(atoms.SelectProps{
                        Placeholder: "Disabled select",
                        Options: []atoms.SelectOption{
                            {Value: "1", Label: "Option 1"},
                        },
                        Disabled: true,
                    })
                }
            }
            
            @Section("Checkbox") {
                <div class="space-y-4">
                    @atoms.Checkbox(atoms.CheckboxProps{Name: "c1", Label: "Unchecked", Value: "1"})
                    @atoms.Checkbox(atoms.CheckboxProps{Name: "c2", Label: "Checked", Value: "2", Checked: true})
                    @atoms.Checkbox(atoms.CheckboxProps{Name: "c3", Label: "Disabled", Value: "3", Disabled: true})
                    @atoms.Checkbox(atoms.CheckboxProps{Name: "c4", Label: "Disabled checked", Value: "4", Disabled: true, Checked: true})
                    @atoms.Checkbox(atoms.CheckboxProps{
                        Name: "c5",
                        Label: "With description",
                        Value: "5",
                        Description: "This is helpful text that provides more context",
                    })
                </div>
            }
            
            @Section("Radio") {
                <div class="space-y-4">
                    @atoms.Radio(atoms.RadioProps{Name: "r", ID: "r1", Label: "Option A", Value: "a"})
                    @atoms.Radio(atoms.RadioProps{Name: "r", ID: "r2", Label: "Option B", Value: "b", Checked: true})
                    @atoms.Radio(atoms.RadioProps{Name: "r", ID: "r3", Label: "Option C", Value: "c"})
                    @atoms.Radio(atoms.RadioProps{Name: "r", ID: "r4", Label: "Disabled", Value: "d", Disabled: true})
                </div>
            }
            
            @Section("Switch") {
                <div class="space-y-4">
                    @atoms.Switch(atoms.SwitchProps{ID: "s1", Name: "s1", Label: "Off"})
                    @atoms.Switch(atoms.SwitchProps{ID: "s2", Name: "s2", Label: "On", Checked: true})
                    @atoms.Switch(atoms.SwitchProps{ID: "s3", Name: "s3", Label: "Disabled off", Disabled: true})
                    @atoms.Switch(atoms.SwitchProps{ID: "s4", Name: "s4", Label: "Disabled on", Disabled: true, Checked: true})
                </div>
            }
            
            // ════════════════════════════════════════════════════════════
            // DISPLAY COMPONENTS
            // ════════════════════════════════════════════════════════════
            @Section("Text Sizes") {
                <div class="space-y-2">
                    @atoms.Text(atoms.TextProps{Text: "Extra small text", Size: atoms.TextXs})
                    @atoms.Text(atoms.TextProps{Text: "Small text", Size: atoms.TextSm})
                    @atoms.Text(atoms.TextProps{Text: "Base text (default)", Size: atoms.TextBase})
                    @atoms.Text(atoms.TextProps{Text: "Large text", Size: atoms.TextLg})
                    @atoms.Text(atoms.TextProps{Text: "Extra large text", Size: atoms.TextXl})
                </div>
            }
            
            @Section("Text Weights") {
                <div class="space-y-2">
                    @atoms.Text(atoms.TextProps{Text: "Normal weight", Weight: atoms.WeightNormal})
                    @atoms.Text(atoms.TextProps{Text: "Medium weight", Weight: atoms.WeightMedium})
                    @atoms.Text(atoms.TextProps{Text: "Semibold weight", Weight: atoms.WeightSemibold})
                    @atoms.Text(atoms.TextProps{Text: "Bold weight", Weight: atoms.WeightBold})
                </div>
            }
            
            @Section("Text States") {
                <div class="space-y-2">
                    @atoms.Text(atoms.TextProps{Text: "Regular text"})
                    @atoms.Text(atoms.TextProps{Text: "Muted text", Variant: atoms.TextMuted})
                    @atoms.Text(atoms.TextProps{Text: "Large muted text", Size: atoms.TextLg, Variant: atoms.TextMuted})
                </div>
            }
            
            @Section("Headings") {
                <div class="space-y-4">
                    @atoms.Heading(atoms.HeadingProps{Level: 1, Text: "Heading 1"})
                    @atoms.Heading(atoms.HeadingProps{Level: 2, Text: "Heading 2"})
                    @atoms.Heading(atoms.HeadingProps{Level: 3, Text: "Heading 3"})
                    @atoms.Heading(atoms.HeadingProps{Level: 4, Text: "Heading 4"})
                    @atoms.Heading(atoms.HeadingProps{Level: 5, Text: "Heading 5"})
                    @atoms.Heading(atoms.HeadingProps{Level: 6, Text: "Heading 6"})
                </div>
            }
            
            @Section("Badge Variants") {
                @atoms.Flex(atoms.FlexProps{Gap: atoms.Gap4, Wrap: atoms.Wrap}) {
                    @atoms.Badge(atoms.BadgeProps{Text: "Default"})
                    @atoms.Badge(atoms.BadgeProps{Text: "Secondary", Variant: components.BadgeSecondary})
                    @atoms.Badge(atoms.BadgeProps{Text: "Destructive", Variant: components.BadgeDestructive})
                }
            }
            
            @Section("Avatar Sizes") {
                @atoms.Flex(atoms.FlexProps{Gap: atoms.Gap4, Align: atoms.AlignCenter}) {
                    @atoms.Avatar(atoms.AvatarProps{Initials: "SM", Size: components.SizeSm})
                    @atoms.Avatar(atoms.AvatarProps{Initials: "MD", Size: components.SizeDefault})
                    @atoms.Avatar(atoms.AvatarProps{Initials: "LG", Size: components.SizeLg})
                }
            }
            
            @Section("Avatar Variants") {
                @atoms.Flex(atoms.FlexProps{Gap: atoms.Gap4, Align: atoms.AlignCenter}) {
                    @atoms.Avatar(atoms.AvatarProps{
                        Src: "https://github.com/shadcn.png",
                        Alt: "User with image",
                        Size: components.SizeDefault,
                    })
                    @atoms.Avatar(atoms.AvatarProps{
                        Initials: "JD",
                        Size: components.SizeDefault,
                    })
                    @atoms.Avatar(atoms.AvatarProps{
                        Initials: "?",
                        Size: components.SizeDefault,
                    })
                }
            }
            
            @Section("Icons") {
                @atoms.Flex(atoms.FlexProps{Gap: atoms.Gap4, Align: atoms.AlignCenter}) {
                    @atoms.Icon(atoms.IconProps{Name: "home", Size: components.SizeSm})
                    @atoms.Icon(atoms.IconProps{Name: "settings", Size: components.SizeDefault})
                    @atoms.Icon(atoms.IconProps{Name: "user", Size: components.SizeLg})
                    @atoms.Icon(atoms.IconProps{Name: "loader", Size: components.SizeDefault})
                }
            }
            
            @Section("Code") {
                <div class="space-y-4">
                    @atoms.Flex(atoms.FlexProps{Gap: "gap-2", Align: "items-center"}) {
                        @atoms.Text(atoms.TextProps{Text: "Inline code:"})
                        @atoms.Code(atoms.CodeProps{Text: "const x = 42"})
                    }
                    @atoms.Box(atoms.BoxProps{Class: "max-w-md"}) {
                        @atoms.Code(atoms.CodeProps{
                            Text: `function hello(name) {
  return "Hello, " + name + "!";
}`,
                            Variant: components.CodeBlock,
                        })
                    }
                </div>
            }
            
            @Section("Keyboard Shortcuts") {
                @atoms.Flex(atoms.FlexProps{Gap: atoms.Gap4, Wrap: atoms.Wrap}) {
                    @atoms.Kbd(atoms.KbdProps{Text: "Ctrl+C"})
                    @atoms.Kbd(atoms.KbdProps{Text: "⌘K"})
                    @atoms.Kbd(atoms.KbdProps{Text: "Alt+Shift+F"})
                    @atoms.Kbd(atoms.KbdProps{Text: "Arrow Keys"})
                }
            }
            
            // ════════════════════════════════════════════════════════════
            // FEEDBACK COMPONENTS
            // ════════════════════════════════════════════════════════════
            @Section("Alert Variants") {
                <div class="space-y-4">
                    @atoms.Alert(atoms.AlertProps{
                        Title: "Default Alert",
                        Description: "This is a default alert with neutral styling.",
                    })
                    @atoms.Alert(atoms.AlertProps{
                        Title: "Error",
                        Description: "Something went wrong. Please try again.",
                        Variant: components.AlertDestructive,
                    })
                </div>
            }
            
            @Section("Progress") {
                <div class="space-y-4">
                    @atoms.Progress(atoms.ProgressProps{Value: 0})
                    @atoms.Progress(atoms.ProgressProps{Value: 25})
                    @atoms.Progress(atoms.ProgressProps{Value: 50})
                    @atoms.Progress(atoms.ProgressProps{Value: 75})
                    @atoms.Progress(atoms.ProgressProps{Value: 100})
                </div>
            }
            
            @Section("Spinner") {
                @atoms.Flex(atoms.FlexProps{Gap: atoms.Gap8, Align: atoms.AlignCenter}) {
                    <div class="flex flex-col items-center gap-2">
                        @atoms.Spinner(atoms.SpinnerProps{Size: components.SizeSm})
                        @atoms.Text(atoms.TextProps{Text: "Small", Size: atoms.TextSm, Variant: atoms.TextMuted})
                    </div>
                    <div class="flex flex-col items-center gap-2">
                        @atoms.Spinner(atoms.SpinnerProps{Size: components.SizeDefault})
                        @atoms.Text(atoms.TextProps{Text: "Default", Size: atoms.TextSm, Variant: atoms.TextMuted})
                    </div>
                    <div class="flex flex-col items-center gap-2">
                        @atoms.Spinner(atoms.SpinnerProps{Size: components.SizeLg})
                        @atoms.Text(atoms.TextProps{Text: "Large", Size: atoms.TextSm, Variant: atoms.TextMuted})
                    </div>
                }
            }
            
            @Section("Skeleton") {
                <div class="space-y-4">
                    @atoms.Text(atoms.TextProps{Text: "Text skeleton", Weight: atoms.WeightMedium})
                    <div class="space-y-2">
                        @atoms.Skeleton(atoms.SkeletonProps{Width: "16rem", Height: "1rem"})
                        @atoms.Skeleton(atoms.SkeletonProps{Width: "12rem", Height: "1rem"})
                        @atoms.Skeleton(atoms.SkeletonProps{Width: "8rem", Height: "1rem"})
                    </div>
                    
                    @atoms.Text(atoms.TextProps{Text: "Avatar skeleton", Weight: atoms.WeightMedium})
                    @atoms.Flex(atoms.FlexProps{Gap: atoms.Gap4}) {
                        @atoms.Skeleton(atoms.SkeletonProps{Shape: "avatar", Size: "sm"})
                        @atoms.Skeleton(atoms.SkeletonProps{Shape: "avatar", Size: "md"})
                        @atoms.Skeleton(atoms.SkeletonProps{Shape: "avatar", Size: "lg"})
                    }
                    
                    @atoms.Text(atoms.TextProps{Text: "Card skeleton", Weight: atoms.WeightMedium})
                    @atoms.Box(atoms.BoxProps{Class: "max-w-sm"}) {
                        @atoms.Skeleton(atoms.SkeletonProps{Width: "100%", Height: "12rem"})
                    }
                </div>
            }
            
            // ════════════════════════════════════════════════════════════
            // STRUCTURAL COMPONENTS
            // ════════════════════════════════════════════════════════════
            @Section("Separator") {
                <div class="space-y-4">
                    @atoms.Text(atoms.TextProps{Text: "Content above separator"})
                    @atoms.Separator(atoms.SeparatorProps{})
                    @atoms.Text(atoms.TextProps{Text: "Content below separator"})
                </div>
            }
            
            @Section("Vertical Separator") {
                @atoms.Flex(atoms.FlexProps{Gap: atoms.Gap4, Align: atoms.AlignCenter}) {
                    @atoms.Text(atoms.TextProps{Text: "Left"})
                    @atoms.Separator(atoms.SeparatorProps{Class: "h-4 w-px"})
                    @atoms.Text(atoms.TextProps{Text: "Right"})
                }
            }
            
            @Section("Divider with Label") {
                <div class="space-y-4">
                    @atoms.Divider(atoms.DividerProps{Class: "my-4"})
                    @atoms.Divider(atoms.DividerProps{Class: "my-4"})
                </div>
            }
            
            @Section("Link Variants") {
                <div class="space-y-2">
                    @atoms.Link(atoms.LinkProps{Href: "#", Text: "Default link"})
                    @atoms.Link(atoms.LinkProps{Href: "#", Text: "Muted link", Variant: atoms.LinkMuted})
                    @atoms.Link(atoms.LinkProps{
                        Href: "https://example.com",
                        Text: "External link",
                        External: true,
                    })
                </div>
            }
        </div>
    }
}

// Section helper component
templ Section(title string) {
    @atoms.Box(atoms.BoxProps{
        Class: "border border-border rounded-lg p-6",
    }) {
        <div class="space-y-4">
            @atoms.Heading(atoms.HeadingProps{Level: 3, Text: title})
            { children... }
        </div>
    }
}