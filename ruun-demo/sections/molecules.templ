package sections

import (
    "github.com/a-h/templ"
    "github.com/niiniyare/ruun/views/components/atoms"
    "github.com/niiniyare/ruun/views/components/molecules"
    "github.com/niiniyare/ruun/views/components"
)

templ MoleculesPage() {
    @DemoLayout("Molecules", "molecules") {
        <div class="space-y-8">
            @atoms.Heading(atoms.HeadingProps{Level: 1, Text: "Molecules"})
            @atoms.Text(atoms.TextProps{
                Text: "Combinations of atoms working together as a unified component.",
                Variant: atoms.TextMuted,
            })
            
            // ════════════════════════════════════════════════════════════
            // CARD
            // ════════════════════════════════════════════════════════════
            @Section("Card") {
                @atoms.Grid(atoms.GridProps{Cols: 2, Gap: atoms.Gap6}) {
                    @molecules.Card(molecules.CardProps{
                        Title: "Basic Card",
                        Description: "A simple card with title and description",
                    })
                    
                    @molecules.Card(molecules.CardProps{
                        Title: "Card with Content",
                        Content: cardContent(),
                    })
                    
                    @molecules.Card(molecules.CardProps{
                        Title: "Card with Actions",
                        Description: "Card with header actions",
                        Content: cardContentSimple(),
                        HeaderAction: cardActions(),
                    })
                    
                    @molecules.CardWithBorder(molecules.CardProps{
                        Title: "Border Card",
                        Description: "Card with border styling",
                        Content: cardContentSimple(),
                    })
                }
            }
            
            // ════════════════════════════════════════════════════════════
            // FORM FIELD
            // ════════════════════════════════════════════════════════════
            @Section("Form Field") {
                @atoms.Grid(atoms.GridProps{Cols: 2, Gap: atoms.Gap6}) {
                    @molecules.FormField(molecules.FormFieldProps{
                        Label: "Email",
                        Name: "email",
                        Type: molecules.FormFieldEmail,
                        Placeholder: "name@example.com",
                        ID: "field-email",
                        HelpText: "We'll never share your email",
                    })
                    
                    @molecules.FormField(molecules.FormFieldProps{
                        Label: "Password",
                        Name: "password",
                        Type: molecules.FormFieldPassword,
                        ID: "field-password",
                        Required: true,
                    })
                    
                    @molecules.FormField(molecules.FormFieldProps{
                        Label: "Country",
                        Name: "country",
                        Type: molecules.FormFieldSelect,
                        ID: "field-country",
                        Options: []molecules.FormFieldOption{
                            {Value: "", Label: "Select country"},
                            {Value: "us", Label: "United States"},
                            {Value: "uk", Label: "United Kingdom"},
                            {Value: "ca", Label: "Canada"},
                        },
                    })
                    
                    @molecules.FormField(molecules.FormFieldProps{
                        Label: "Bio",
                        Name: "bio",
                        Type: molecules.FormFieldTextarea,
                        ID: "field-bio",
                        Placeholder: "Tell us about yourself",
                        HelpText: "Maximum 500 characters",
                    })
                    
                    @molecules.FormField(molecules.FormFieldProps{
                        Label: "Field with Error",
                        Name: "error-field",
                        Type: molecules.FormFieldText,
                        ID: "field-error",
                        HasError: true,
                        Errors: []string{"This field is required"},
                    })
                }
            }
            
            // ════════════════════════════════════════════════════════════
            // BUTTON GROUP
            // ════════════════════════════════════════════════════════════
            @Section("Button Group") {
                <div class="space-y-6">
                    <div>
                        @atoms.Text(atoms.TextProps{Text: "Horizontal Button Group", Weight: atoms.WeightMedium})
                        @molecules.ButtonGroup(molecules.ButtonGroupProps{
                            Buttons: []molecules.ButtonConfig{
                                {Text: "Left", Variant: components.ButtonDefault},
                                {Text: "Center", Variant: components.ButtonDefault},
                                {Text: "Right", Variant: components.ButtonDefault},
                            },
                            Orientation: components.OrientationHorizontal,
                        })
                    </div>
                    
                    <div>
                        @atoms.Text(atoms.TextProps{Text: "Vertical Button Group", Weight: atoms.WeightMedium})
                        @molecules.ButtonGroup(molecules.ButtonGroupProps{
                            Buttons: []molecules.ButtonConfig{
                                {Text: "First", Variant: components.ButtonDefault},
                                {Text: "Second", Variant: components.ButtonDefault},
                                {Text: "Third", Variant: components.ButtonDefault},
                            },
                            Orientation: components.OrientationVertical,
                        })
                    </div>
                    
                    <div>
                        @atoms.Text(atoms.TextProps{Text: "Mixed Variants", Weight: atoms.WeightMedium})
                        @molecules.ButtonGroup(molecules.ButtonGroupProps{
                            Buttons: []molecules.ButtonConfig{
                                {Text: "Save", Variant: components.ButtonPrimary},
                                {Text: "Cancel", Variant: components.ButtonSecondary},
                                {Text: "Delete", Variant: components.ButtonDestructive},
                            },
                            Orientation: components.OrientationHorizontal,
                        })
                    </div>
                </div>
            }
            
            // ════════════════════════════════════════════════════════════
            // SEARCH BOX
            // ════════════════════════════════════════════════════════════
            @Section("Search Box") {
                <div class="space-y-4 max-w-md">
                    @molecules.SearchBox(molecules.SearchBoxProps{
                        ID: "search-1",
                        Name: "search-1",
                        Placeholder: "Search...",
                    })
                    
                    @molecules.SearchBox(molecules.SearchBoxProps{
                        ID: "search-2",
                        Name: "search-2",
                        Placeholder: "Search with suggestions",
                        Suggestions: []molecules.SearchSuggestion{
                            {Value: "user", Label: "User Management"},
                            {Value: "product", Label: "Product Catalog"},
                            {Value: "order", Label: "Order History"},
                        },
                    })
                    
                    @molecules.SearchBox(molecules.SearchBoxProps{
                        ID: "search-3",
                        Name: "search-3",
                        Placeholder: "Loading search",
                        Loading: true,
                    })
                </div>
            }
            
            // ════════════════════════════════════════════════════════════
            // DROPDOWN MENU
            // ════════════════════════════════════════════════════════════
            @Section("Dropdown Menu") {
                @atoms.Flex(atoms.FlexProps{Gap: atoms.Gap4}) {
                    @molecules.SimpleDropdownMenu("dropdown-1", "Simple Menu", []molecules.DropdownMenuItem{
                        {Text: "Profile", Icon: "user"},
                        {Text: "Settings", Icon: "settings"},
                        {Text: "Logout", Icon: "log-out"},
                    })
                    
                    @molecules.UserDropdownMenu("user-dropdown", "John Doe")
                    
                    @molecules.ActionsDropdownMenu("actions", []molecules.DropdownMenuItem{
                        {Text: "Edit", Icon: "edit"},
                        {Text: "Delete", Icon: "trash"},
                    })
                }
            }
            
            // ════════════════════════════════════════════════════════════
            // VALIDATION
            // ════════════════════════════════════════════════════════════
            @Section("Validation") {
                <div class="space-y-4 max-w-md">
                    @molecules.ValidationMessages(molecules.ValidationProps{
                        FieldName: "email",
                        Messages: []molecules.ValidationMessage{
                            {Type: molecules.ValidationError, Message: "Email is required"},
                            {Type: molecules.ValidationError, Message: "Invalid email format"},
                        },
                    })
                    
                    @molecules.FieldValidation(molecules.FieldValidationProps{
                        FieldName: "password",
                        Messages: []molecules.ValidationMessage{
                            {Type: molecules.ValidationWarning, Message: "Password should be at least 8 characters"},
                            {Type: molecules.ValidationSuccess, Message: "Password strength: Good"},
                        },
                        ShowIcon: true,
                    })
                </div>
            }
        </div>
    }
}

// Helper components for card content
templ cardContent() {
    <div class="space-y-2">
        @atoms.Text(atoms.TextProps{Text: "This is some sample content inside a card."})
        @atoms.Button(atoms.ButtonProps{Text: "Action Button", Size: components.SizeSm})
    </div>
}

templ cardContentSimple() {
    @atoms.Text(atoms.TextProps{Text: "Simple card content with just text."})
}

templ cardActions() {
    @atoms.Button(atoms.ButtonProps{
        Text: "Edit", 
        Size: components.SizeSm,
        Variant: components.ButtonSecondary,
    })
}