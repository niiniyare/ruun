package sections

import (
	"github.com/niiniyare/ruun/components/atoms"
	"github.com/niiniyare/ruun/components/molecules"
	"github.com/niiniyare/ruun/components/templates"
	"github.com/niiniyare/ruun/components"
)

// DemoLayout wraps all demo pages with navigation
templ DemoLayout(title string, activeSection string) {
	@templates.BaseLayout(templates.BaseLayoutProps{
		Title: title + " - Ruun Kitchen Sink",
		Theme: "default",
	}) {
		@templates.EnhancedPageLayout(templates.EnhancedPageLayoutProps{
			Layout: templates.PageLayoutSidebar,
			Sidebar: demoSidebar(activeSection),
			TopBar:  demoTopBar(title),
			Main:    demoMainContent(),
		}) {
			{ children... }
		}
	}
}

// demoSidebar creates the navigation sidebar
templ demoSidebar(activeSection string) {
	@molecules.Card(molecules.CardProps{
		Base: components.BaseProps{
			ClassName: "h-full border-0 rounded-none",
		},
		Header: demoSidebarHeader(),
		Content: demoSidebarNav(activeSection),
	})
}

// demoSidebarHeader creates the sidebar header with logo
templ demoSidebarHeader() {
	<div class="space-y-2">
		<h2 class="text-lg font-semibold">Ruun UI</h2>
		<p class="text-sm text-muted-foreground">Component Kitchen Sink</p>
	</div>
}

// demoSidebarNav creates the navigation menu
templ demoSidebarNav(activeSection string) {
	<nav class="space-y-1">
		@navItem("/", "Overview", "overview", activeSection)
		@navItem("/atoms", "Atoms", "atoms", activeSection)
		@navItem("/molecules", "Molecules", "molecules", activeSection)
		@navItem("/organisms", "Organisms", "organisms", activeSection)
		@navItem("/templates", "Templates", "templates", activeSection)
		@navItem("/examples", "Examples", "examples", activeSection)
	</nav>
}

// navItem creates a single navigation link
templ navItem(href, label, section, activeSection string) {
	@atoms.Button(atoms.ButtonProps{
		Text:    label,
		Variant: getNavVariant(section, activeSection),
		Size:    components.SizeSm,
		Base: components.BaseProps{
			ClassName: "w-full justify-start mb-1",
		},
		HTMX: components.HTMXProps{
			Get:    href,
			Target: "#main-content",
			Swap:   "innerHTML",
		},
	})
}

// getNavVariant determines the button variant for navigation
func getNavVariant(section, active string) components.ButtonVariant {
	if section == active {
		return components.ButtonPrimary
	}
	return components.ButtonGhost
}

// demoTopBar creates the top navigation bar
templ demoTopBar(title string) {
	<header class="flex items-center justify-between px-6 py-3 border-b">
		<h1 class="text-xl font-semibold">{title}</h1>
		@demoTopBarActions()
	</header>
}

// demoTopBarActions creates the top bar action buttons
templ demoTopBarActions() {
	<div class="flex items-center space-x-3">
		@atoms.Button(atoms.ButtonProps{
			Text:    "Theme",
			Variant: components.ButtonOutline,
			Size:    components.SizeSm,
			Icon:    sunIcon(),
		})
		@atoms.Button(atoms.ButtonProps{
			Text:    "GitHub",
			Variant: components.ButtonOutline,
			Size:    components.SizeSm,
			Icon:    githubIcon(),
		})
	</div>
}

// demoMainContent wrapper for main content area
templ demoMainContent() {
	<main id="main-content" class="flex-1 overflow-auto p-6">
		{ children... }
	</main>
}

// Section creates a demo section wrapper
templ Section(title string) {
	@molecules.Card(molecules.CardProps{
		Title:   title,
		Content: sectionContent(),
		Base: components.BaseProps{
			ClassName: "mb-6",
		},
	}) {
		{ children... }
	}
}

// sectionContent creates section content wrapper
templ sectionContent() {
	<div class="space-y-4">
		{ children... }
	</div>
}

// ComponentGrid creates a grid layout for component examples
templ ComponentGrid() {
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
		{ children... }
	</div>
}

// ComponentExample wraps individual component examples
templ ComponentExample(title string, description string) {
	@molecules.Card(molecules.CardProps{
		Title:       title,
		Description: description,
		Content:     exampleContent(),
		Base: components.BaseProps{
			ClassName: "h-full",
		},
	}) {
		{ children... }
	}
}

// exampleContent creates example content wrapper
templ exampleContent() {
	<div class="flex flex-col space-y-3">
		<div class="flex-1 border rounded-lg p-4 bg-muted/30">
			{ children... }
		</div>
	</div>
}

// PropsTable creates a table for displaying component props
templ PropsTable() {
	<div class="mt-4">
		<h4 class="text-sm font-medium mb-2">Props</h4>
		<div class="border rounded-lg overflow-hidden">
			<table class="w-full text-sm">
				<thead class="bg-muted">
					<tr>
						<th class="px-3 py-2 text-left font-medium">Prop</th>
						<th class="px-3 py-2 text-left font-medium">Type</th>
						<th class="px-3 py-2 text-left font-medium">Default</th>
						<th class="px-3 py-2 text-left font-medium">Description</th>
					</tr>
				</thead>
				<tbody class="divide-y">
					{ children... }
				</tbody>
			</table>
		</div>
	</div>
}

// PropRow creates a table row for component props
templ PropRow(prop, propType, defaultVal, description string) {
	<tr>
		<td class="px-3 py-2 font-mono text-xs">{prop}</td>
		<td class="px-3 py-2 text-muted-foreground">{propType}</td>
		<td class="px-3 py-2 font-mono text-xs">{defaultVal}</td>
		<td class="px-3 py-2">{description}</td>
	</tr>
}

// CodeBlock creates a code block for showing component usage
templ CodeBlock(code string) {
	<div class="mt-4">
		<h4 class="text-sm font-medium mb-2">Usage</h4>
		<div class="border rounded-lg p-4 bg-muted/50">
			<pre class="text-xs overflow-x-auto"><code>{code}</code></pre>
		</div>
	</div>
}

// Helper icon components (these would normally be from an icon package)
templ sunIcon() {
	<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<circle cx="12" cy="12" r="5"></circle>
		<line x1="12" y1="1" x2="12" y2="3"></line>
		<line x1="12" y1="21" x2="12" y2="23"></line>
		<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
		<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
		<line x1="1" y1="12" x2="3" y2="12"></line>
		<line x1="21" y1="12" x2="23" y2="12"></line>
		<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
		<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
	</svg>
}

