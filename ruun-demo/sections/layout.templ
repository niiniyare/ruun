package sections

import (
	"github.com/niiniyare/ruun/views/components/atoms"
	"github.com/niiniyare/ruun/views/components/molecules" 
	"github.com/niiniyare/ruun/views/components/templates"
)

// DemoLayout wraps all demo pages with navigation
templ DemoLayout(title string, activeSection string) {
	@templates.BaseHTML(templates.BaseHTMLProps{
		Title: title + " - Ruun Kitchen Sink",
	}) {
		@atoms.Flex(atoms.FlexProps{Direction: atoms.Row}) {
			// Sidebar
			@DemoSidebar(activeSection)
			
			// Main content area
			@atoms.Box(atoms.BoxProps{Padding: atoms.P8, Flex: atoms.Flex1}) {
				{ children... }
			}
		}
	}
}

// DemoSidebar creates the navigation sidebar
templ DemoSidebar(activeSection string) {
	@atoms.Box(atoms.BoxProps{
		Width: atoms.W64,
		Padding: atoms.P4,
		Border: true,
		BorderSide: atoms.BorderRight,
		BgColor: atoms.BgMuted,
		MinHeight: atoms.MinHScreen,
	}) {
		// Logo/Title
		@atoms.Stack(atoms.StackProps{Gap: atoms.Gap4, Padding: atoms.P4}) {
			@atoms.Heading(atoms.HeadingProps{Level: 2, Text: "Ruun UI"})
			@atoms.Text(atoms.TextProps{Text: "Kitchen Sink", Size: atoms.TextSm, Muted: true})
		}
		
		@atoms.Divider(atoms.DividerProps{})
		
		// Navigation
		@atoms.Stack(atoms.StackProps{Gap: atoms.Gap1, Padding: atoms.P2}) {
			@NavItem("/", "Overview", "overview", activeSection)
			@NavItem("/atoms", "Atoms", "atoms", activeSection)
			@NavItem("/molecules", "Molecules", "molecules", activeSection)
			@NavItem("/organisms", "Organisms", "organisms", activeSection)
			@NavItem("/templates", "Templates", "templates", activeSection)
			@NavItem("/examples", "Examples", "examples", activeSection)
		}
	}
}

// NavItem creates a single navigation link
templ NavItem(href, label, section, activeSection string) {
	@atoms.Link(atoms.LinkProps{
		Href: href,
		Text: label,
		Variant: getNavVariant(section, activeSection),
		Block: true,
		Padding: atoms.P2,
		Rounded: atoms.RoundedMd,
	})
}

func getNavVariant(section, active string) atoms.LinkVariant {
	if section == active {
		return atoms.LinkActive
	}
	return atoms.LinkNav
}

// Section creates a demo section wrapper
templ Section(title string) {
	@atoms.Box(atoms.BoxProps{Padding: atoms.P6, Border: true, Rounded: atoms.RoundedLg, Margin: atoms.M4}) {
		@atoms.Heading(atoms.HeadingProps{Level: 3, Text: title})
		@atoms.Box(atoms.BoxProps{Padding: atoms.P4}) {
			{ children... }
		}
	}
}

// ComponentGrid creates a grid layout for component examples
templ ComponentGrid() {
	@atoms.Grid(atoms.GridProps{Cols: atoms.Cols3, Gap: atoms.Gap4}) {
		{ children... }
	}
}

// ComponentExample wraps individual component examples
templ ComponentExample(title string, description string) {
	@molecules.Card(molecules.CardProps{
		Title: title,
		Description: description,
		Padding: atoms.P4,
		Border: true,
		Rounded: atoms.RoundedLg,
	}) {
		@atoms.Box(atoms.BoxProps{
			Padding: atoms.P4,
			Border: true,
			BgColor: atoms.BgMuted,
			Rounded: atoms.RoundedMd,
		}) {
			{ children... }
		}
	}
}

// PropsTable creates a table for displaying component props
templ PropsTable() {
	@atoms.Box(atoms.BoxProps{Margin: atoms.MT4}) {
		@atoms.Heading(atoms.HeadingProps{Level: 4, Text: "Props", Size: atoms.TextSm})
		@atoms.Box(atoms.BoxProps{
			Border: true,
			Rounded: atoms.RoundedLg,
			Overflow: atoms.OverflowHidden,
			Margin: atoms.MT2,
		}) {
			@atoms.Grid(atoms.GridProps{Cols: atoms.Cols4}) {
				// Header
				@atoms.Box(atoms.BoxProps{Padding: atoms.P3, BgColor: atoms.BgMuted}) {
					@atoms.Text(atoms.TextProps{Text: "Prop", Weight: atoms.FontMedium, Size: atoms.TextSm})
				}
				@atoms.Box(atoms.BoxProps{Padding: atoms.P3, BgColor: atoms.BgMuted}) {
					@atoms.Text(atoms.TextProps{Text: "Type", Weight: atoms.FontMedium, Size: atoms.TextSm})
				}
				@atoms.Box(atoms.BoxProps{Padding: atoms.P3, BgColor: atoms.BgMuted}) {
					@atoms.Text(atoms.TextProps{Text: "Default", Weight: atoms.FontMedium, Size: atoms.TextSm})
				}
				@atoms.Box(atoms.BoxProps{Padding: atoms.P3, BgColor: atoms.BgMuted}) {
					@atoms.Text(atoms.TextProps{Text: "Description", Weight: atoms.FontMedium, Size: atoms.TextSm})
				}
				
				{ children... }
			}
		}
	}
}

// PropRow creates a table row for component props
templ PropRow(prop, propType, defaultVal, description string) {
	@atoms.Box(atoms.BoxProps{Padding: atoms.P3}) {
		@atoms.Text(atoms.TextProps{Text: prop, Font: atoms.FontMono, Size: atoms.TextXs})
	}
	@atoms.Box(atoms.BoxProps{Padding: atoms.P3}) {
		@atoms.Text(atoms.TextProps{Text: propType, Muted: true, Size: atoms.TextSm})
	}
	@atoms.Box(atoms.BoxProps{Padding: atoms.P3}) {
		@atoms.Text(atoms.TextProps{Text: defaultVal, Font: atoms.FontMono, Size: atoms.TextXs})
	}
	@atoms.Box(atoms.BoxProps{Padding: atoms.P3}) {
		@atoms.Text(atoms.TextProps{Text: description, Size: atoms.TextSm})
	}
}

// CodeBlock creates a code block for showing component usage
templ CodeBlock(code string) {
	@atoms.Box(atoms.BoxProps{Margin: atoms.MT4}) {
		@atoms.Heading(atoms.HeadingProps{Level: 4, Text: "Usage", Size: atoms.TextSm})
		@atoms.Box(atoms.BoxProps{
			Border: true,
			Rounded: atoms.RoundedLg,
			Padding: atoms.P4,
			BgColor: atoms.BgMuted,
			Margin: atoms.MT2,
		}) {
			@atoms.Text(atoms.TextProps{
				Text: code,
				Font: atoms.FontMono,
				Size: atoms.TextXs,
				Whitespace: atoms.WhitespacePre,
			})
		}
	}
}