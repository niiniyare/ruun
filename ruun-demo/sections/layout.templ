package sections

import (
	"github.com/niiniyare/ruun/views/components/atoms"
	"github.com/niiniyare/ruun/views/components/molecules" 
	"github.com/niiniyare/ruun/views/components/templates"
	"github.com/niiniyare/ruun/views/components"
)

// DemoLayout wraps all demo pages with navigation
templ DemoLayout(title string, activeSection string) {
	@templates.BaseLayout(templates.BaseLayoutProps{
		Meta: templates.PageMeta{Title: title + " - Ruun Kitchen Sink"},
	}) {
		@atoms.Flex(atoms.FlexProps{Direction: "flex-row"}) {
			// Sidebar
			@DemoSidebar(activeSection)
			
			// Main content area
			@atoms.Box(atoms.BoxProps{Class: "p-8 flex-1"}) {
				{ children... }
			}
		}
	}
}

// DemoSidebar creates the navigation sidebar
templ DemoSidebar(activeSection string) {
	@atoms.Box(atoms.BoxProps{
		Class: "w-64 p-4 border-r border-border bg-muted min-h-screen",
	}) {
		// Logo/Title
		<div class="p-4 space-y-4">
			@atoms.Heading(atoms.HeadingProps{Level: 2, Text: "Ruun UI"})
			@atoms.Text(atoms.TextProps{Text: "Kitchen Sink", Size: "text-sm", Muted: true})
		</div>
		
		@atoms.Divider(atoms.DividerProps{})
		
		// Navigation
		<div class="p-2 space-y-1">
			@NavItem("/", "Overview", "overview", activeSection)
			@NavItem("/atoms", "Atoms", "atoms", activeSection)
			@NavItem("/molecules", "Molecules", "molecules", activeSection)
			@NavItem("/organisms", "Organisms", "organisms", activeSection)
			@NavItem("/templates", "Templates", "templates", activeSection)
			@NavItem("/examples", "Examples", "examples", activeSection)
		</div>
	}
}

// NavItem creates a single navigation link
templ NavItem(href, label, section, activeSection string) {
	@atoms.Link(atoms.LinkProps{
		Href: href,
		Text: label,
		Variant: getNavVariant(section, activeSection),
		Base: components.BaseProps{
			ClassName: "block p-2 rounded-md",
		},
	})
}

func getNavVariant(section, active string) atoms.LinkVariant {
	if section == active {
		return "default"
	}
	return "muted"
}

// Section creates a demo section wrapper
templ Section(title string) {
	@atoms.Box(atoms.BoxProps{Class: "p-6 border border-border rounded-lg m-4"}) {
		@atoms.Heading(atoms.HeadingProps{Level: 3, Text: title})
		@atoms.Box(atoms.BoxProps{Class: "p-4"}) {
			{ children... }
		}
	}
}

// ComponentGrid creates a grid layout for component examples
templ ComponentGrid() {
	@atoms.Grid(atoms.GridProps{Cols: 3, Gap: "gap-4"}) {
		{ children... }
	}
}

// ComponentExample wraps individual component examples
templ ComponentExample(title string, description string) {
	@molecules.Card(molecules.CardProps{
		Title: title,
		Description: description,
		Border: true,
	}) {
		@atoms.Box(atoms.BoxProps{
			Class: "p-4 border border-border bg-muted rounded-md",
		}) {
			{ children... }
		}
	}
}

// PropsTable creates a table for displaying component props
templ PropsTable() {
	@atoms.Box(atoms.BoxProps{Class: "mt-4"}) {
		@atoms.Heading(atoms.HeadingProps{Level: 4, Text: "Props"})
		@atoms.Box(atoms.BoxProps{
			Class: "border border-border rounded-lg overflow-hidden mt-2",
		}) {
			@atoms.Grid(atoms.GridProps{Cols: 4}) {
				// Header
				@atoms.Box(atoms.BoxProps{Class: "p-3 bg-muted"}) {
					@atoms.Text(atoms.TextProps{Text: "Prop", Weight: "font-medium", Size: "text-sm"})
				}
				@atoms.Box(atoms.BoxProps{Class: "p-3 bg-muted"}) {
					@atoms.Text(atoms.TextProps{Text: "Type", Weight: "font-medium", Size: "text-sm"})
				}
				@atoms.Box(atoms.BoxProps{Class: "p-3 bg-muted"}) {
					@atoms.Text(atoms.TextProps{Text: "Default", Weight: "font-medium", Size: "text-sm"})
				}
				@atoms.Box(atoms.BoxProps{Class: "p-3 bg-muted"}) {
					@atoms.Text(atoms.TextProps{Text: "Description", Weight: "font-medium", Size: "text-sm"})
				}
				
				{ children... }
			}
		}
	}
}

// PropRow creates a table row for component props
templ PropRow(prop, propType, defaultVal, description string) {
	@atoms.Box(atoms.BoxProps{Class: "p-3"}) {
		@atoms.Text(atoms.TextProps{Text: prop, Weight: "font-mono", Size: "text-xs"})
	}
	@atoms.Box(atoms.BoxProps{Class: "p-3"}) {
		@atoms.Text(atoms.TextProps{Text: propType, Muted: true, Size: "text-sm"})
	}
	@atoms.Box(atoms.BoxProps{Class: "p-3"}) {
		@atoms.Text(atoms.TextProps{Text: defaultVal, Weight: "font-mono", Size: "text-xs"})
	}
	@atoms.Box(atoms.BoxProps{Class: "p-3"}) {
		@atoms.Text(atoms.TextProps{Text: description, Size: "text-sm"})
	}
}

// CodeBlock creates a code block for showing component usage
templ CodeBlock(code string) {
	@atoms.Box(atoms.BoxProps{Class: "mt-4"}) {
		@atoms.Heading(atoms.HeadingProps{Level: 4, Text: "Usage"})
		@atoms.Box(atoms.BoxProps{
			Class: "border border-border rounded-lg p-4 bg-muted mt-2",
		}) {
			@atoms.Code(atoms.CodeProps{
				Text: code,
				Variant: components.CodeBlock,
			})
		}
	}
}