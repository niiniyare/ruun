package sections

import (
	"github.com/a-h/templ"
	"github.com/niiniyare/ruun/views/components/atoms"
	"github.com/niiniyare/ruun/views/components/organisms"
	"github.com/niiniyare/ruun/views/components/molecules"
	"github.com/niiniyare/ruun/views/components"
)

templ OrganismsPage() {
	@DemoLayout("Organisms", "organisms") {
		<div class="space-y-8">
			@atoms.Heading(atoms.HeadingProps{Level: 1, Text: "Organisms"})
			@atoms.Text(atoms.TextProps{
				Text: "Complex components composed of multiple molecules and atoms.",
				Variant: atoms.TextMuted,
			})

			// ════════════════════════════════════════════════════════════
			// NAVIGATION
			// ════════════════════════════════════════════════════════════
			@Section("Navigation") {
				@organisms.Navigation(organisms.NavigationProps{
					ID: "main-nav",
					Items: []organisms.NavigationItem{
						{
							ID:   "dashboard",
							Text: "Dashboard",
							URL:  "/dashboard",
							Icon: "home",
							Active: true,
						},
						{
							ID:    "users",
							Text:  "Users",
							URL:   "/users",
							Icon:  "users",
							Badge: "12",
							Items: []organisms.NavigationItem{
								{ID: "user-list", Text: "User List", URL: "/users/list"},
								{ID: "user-roles", Text: "User Roles", URL: "/users/roles"},
							},
						},
						{
							ID:   "products",
							Text: "Products",
							URL:  "/products",
							Icon: "package",
						},
						{
							ID:   "settings",
							Text: "Settings",
							URL:  "/settings",
							Icon: "settings",
							Disabled: true,
						},
					},
					Brand: organisms.NavigationBrand{
						Text: "Ruun UI",
						URL:  "/",
					},
				})
			}

			// ════════════════════════════════════════════════════════════
			// DATA TABLE
			// ════════════════════════════════════════════════════════════
			@Section("Data Table") {
				@organisms.DataTable(organisms.DataTableProps{
					ID: "users-table",
					Columns: []organisms.DataTableColumn{
						{
							Key:      "id",
							Title:    "ID",
							Type:     organisms.ColumnTypeNumber,
							Sortable: true,
							Width:    "80px",
						},
						{
							Key:      "name",
							Title:    "Name",
							Type:     organisms.ColumnTypeText,
							Sortable: true,
							Width:    "200px",
						},
						{
							Key:      "email",
							Title:    "Email",
							Type:     organisms.ColumnTypeText,
							Sortable: true,
							Width:    "250px",
						},
						{
							Key:   "department",
							Title: "Department",
							Type:  "text",
							Width: "150px",
						},
						{
							Key:   "status",
							Title: "Status",
							Type:  organisms.ColumnTypeBadge,
							Align: "center",
							Width: "120px",
						},
						{
							Key:    "actions",
							Title:  "Actions",
							Type:   organisms.ColumnTypeActions,
							Align:  "right",
							Width:  "100px",
						},
					},
					Rows: []organisms.DataTableRow{
						{
							ID: "1",
							Data: map[string]any{
								"id":         1,
								"name":       "John Doe",
								"email":      "john.doe@example.com",
								"department": "Engineering",
								"status":     "Active",
							},
						},
						{
							ID: "2",
							Data: map[string]any{
								"id":         2,
								"name":       "Jane Smith",
								"email":      "jane.smith@example.com",
								"department": "Design",
								"status":     "Active",
							},
						},
						{
							ID: "3",
							Data: map[string]any{
								"id":         3,
								"name":       "Bob Johnson",
								"email":      "bob.johnson@example.com",
								"department": "Marketing",
								"status":     "Inactive",
							},
						},
					},
					Sortable:   true,
					Selectable: true,
					Pagination: &organisms.DataTablePagination{
						Page:     1,
						PageSize: 10,
						Total:    3,
					},
				})
			}

			// ════════════════════════════════════════════════════════════
			// TABS
			// ════════════════════════════════════════════════════════════
			@Section("Tabs") {
				<div class="space-y-6">
					<div>
						@atoms.Text(atoms.TextProps{Text: "Simple Tabs", Weight: atoms.WeightMedium})
						@organisms.SimpleTabs("simple-tabs", []organisms.TabItem{
							{
								ID:      "tab1",
								Label:   "Overview",
								Content: tabContent("This is the overview tab content."),
								Active:  true,
							},
							{
								ID:      "tab2",
								Label:   "Details",
								Content: tabContent("This is the details tab content."),
							},
							{
								ID:      "tab3",
								Label:   "Settings",
								Content: tabContent("This is the settings tab content."),
							},
						})
					</div>

					<div>
						@atoms.Text(atoms.TextProps{Text: "Tabs with Icons and Badges", Weight: atoms.WeightMedium})
						@organisms.Tabs(organisms.TabsProps{
							ID: "icon-tabs",
							Items: []organisms.TabItem{
								{
									ID:      "messages",
									Label:   "Messages",
									Icon:    "mail",
									Badge:   "5",
									Content: tabContent("You have 5 new messages."),
									Active:  true,
								},
								{
									ID:      "notifications",
									Label:   "Notifications",
									Icon:    "bell",
									Count:   12,
									Content: tabContent("You have 12 notifications."),
								},
								{
									ID:      "tasks",
									Label:   "Tasks",
									Icon:    "check-square",
									Content: tabContent("Your task list is empty."),
									Disabled: false,
								},
							},
						})
					</div>

					<div>
						@atoms.Text(atoms.TextProps{Text: "Vertical Tabs", Weight: atoms.WeightMedium})
						@organisms.VerticalTabs("vertical-tabs", []organisms.TabItem{
							{
								ID:      "profile",
								Label:   "Profile",
								Content: tabContent("Edit your profile information."),
								Active:  true,
							},
							{
								ID:      "account",
								Label:   "Account",
								Content: tabContent("Manage your account settings."),
							},
							{
								ID:      "security",
								Label:   "Security",
								Content: tabContent("Configure security settings."),
							},
						})
					</div>
				</div>
			}

			// ════════════════════════════════════════════════════════════
			// FORMS
			// ════════════════════════════════════════════════════════════
			@Section("Forms") {
				<div class="max-w-2xl">
					@organisms.Form(organisms.FormProps{
						ID:    "contact-form",
						Title: "Contact Information",
						Description: "Please fill out your contact details",
						Fields: []organisms.Field{
							{
								FormFieldProps: molecules.FormFieldProps{
									ID:          "firstName",
									Name:        "firstName",
									Label:       "First Name",
									Type:        molecules.FormFieldText,
									Placeholder: "Enter your first name",
									Required:    true,
								},
							},
							{
								FormFieldProps: molecules.FormFieldProps{
									ID:          "lastName",
									Name:        "lastName",
									Label:       "Last Name",
									Type:        molecules.FormFieldText,
									Placeholder: "Enter your last name",
									Required:    true,
								},
							},
							{
								FormFieldProps: molecules.FormFieldProps{
									ID:          "email",
									Name:        "email",
									Label:       "Email",
									Type:        molecules.FormFieldEmail,
									Placeholder: "Enter your email",
									Required:    true,
									HelpText:    "We'll never share your email",
								},
							},
							{
								FormFieldProps: molecules.FormFieldProps{
									ID:          "message",
									Name:        "message",
									Label:       "Message",
									Type:        molecules.FormFieldTextarea,
									Placeholder: "Enter your message",
									HelpText:    "Maximum 500 characters",
								},
							},
						},
						Actions: []organisms.Action{
							{
								Label: "Submit",
								Type:  "submit",
								ButtonProps: atoms.ButtonProps{
									Text: "Submit",
									Variant: components.ButtonPrimary,
								},
							},
							{
								Label: "Cancel",
								Type:  "button",
								ButtonProps: atoms.ButtonProps{
									Text: "Cancel",
									Variant: components.ButtonSecondary,
								},
							},
						},
					})
				</div>
			}
		</div>
	}
}

// Helper function for tab content
templ tabContent(text string) {
	<div class="p-4">
		@atoms.Text(atoms.TextProps{Text: text})
	</div>
}